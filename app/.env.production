# Committed on purpose — neither value here is secret. VITE_SUPABASE_URL is
# a public address and VITE_SUPABASE_ANON_KEY is the publishable/anon key,
# meant to ship in client code (RLS is what actually protects data, not
# keeping this key hidden). Vite loads this automatically during
# `npm run build` (default mode is "production"), so the Cloudflare
# dashboard's build-variables UI is no longer needed for these two values.
VITE_SUPABASE_URL=https://bmlvurfoksjlckrubehn.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xmk-1TxFH48Rn7SgFjeuxQ_6LSBgXcE
